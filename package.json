{
  "name": "mimoo",
  "version": "1.0.2",
  "description": "Mimoo Desktop Pet pour Windows 10/11",
  "author": "DesktopPet Team",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "generate:assets": "node scripts/generate-placeholders.mjs",
    "build:main": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run generate:assets && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:all": "node scripts/package-dual-editions.mjs"
  },
  "build": {
    "appId": "com.mimoo.desktoppet",
    "productName": "Mimoo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/bin/**/*",
      "dist/assets/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LilianREGNIER",
        "repo": "Mimoo"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
